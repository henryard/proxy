#!name = 国内域名 DNS 映射
#!desc = 将抖音/头条/腾讯/阿里/京东/微博/B站/小红书等国内域名强制指定走境内 DNS，避免境外加密DNS导致CDN选路异常、播放卡顿
#!author = 自用整理
#!icon = https://cdn.jsdelivr.net/gh/henryard/proxy@main/IconSet/CN.png

[host]
# —— Apple ——
iosapps.itunes.apple.com = iosapps.itunes.apple.com.download.ks-cdn.com

# —— Google ——
dl.google.com = server:119.29.29.29
dl.l.google.com = server:119.29.29.29
update.googleapis.com = server:119.29.29.29
mtalk.google.com = 108.177.125.188

# —— 百度系 ——
*.baidu.com = server:https://223.5.5.5/dns-query
*.bdstatic.com = server:https://223.5.5.5/dns-query
